# ══════════════════════════════════════════════════════════════════
#  Andre Fernández «Aji-Panko» — Configuración de producción (Apache)
#  Sube este archivo a la raíz web (public_html/) junto al resto del sitio.
#
#  El dominio canónico es andrefernandez.es y debe coincidir con el
#  <link rel="canonical"> de index.html, con sitemap.xml y con robots.txt.
# ══════════════════════════════════════════════════════════════════

RewriteEngine On

# ── 1. Dominio canónico ───────────────────────────────────────────
# NO se fuerza HTTPS aquí: Hostinger ya redirige http→https en su plataforma y
# una regla `RewriteCond %{HTTPS} off` provocaría un BUCLE infinito, porque su
# SSL termina en un proxy y Apache ve la petición como http. Esta regla solo
# depende del host, así que es segura. (Misma nota que en Web - SAOProjects.)
RewriteCond %{HTTP_HOST} ^www\.andrefernandez\.es$ [NC]
RewriteRule ^ https://andrefernandez.es%{REQUEST_URI} [L,R=301]

# ── 2. Página de error 404 ────────────────────────────────────────
ErrorDocument 404 /404.html

# ── 3. Compresión Gzip ────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ── 4. Cache de navegador ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML sin cache larga: es lo que apunta al CSS con hash de contenido.
  ExpiresByType text/html                 "access plus 0 seconds"
  # CSS y JS: 1 año. El nombre del CSS lleva hash, así que un cambio de estilos
  # se sirve igualmente al instante (ver la tarea `revIndex` del gulpfile).
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ── 5. Cabeceras de seguridad ─────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── 6. No listar directorios ──────────────────────────────────────
Options -Indexes
